@@ -0,0 +1,86 @@
+#ifndef WHISPER_INIT_OWNERSHIP_H
+#define WHISPER_INIT_OWNERSHIP_H
+
+#include <cstdlib>
+#include <limits>
+#include <memory>
+#include <new>
+#include <type_traits>
+#include <vector>
+
+// Value initialization makes partially constructed C-style resource fields safe
+// for the normal deleter before any backend/cache/vector acquisition succeeds.
+template <typename T, void (*Destroy)(T *)>
+std::unique_ptr<T, decltype(Destroy)> whisper_make_init_owner() {
+    return std::unique_ptr<T, decltype(Destroy)>(new T{}, Destroy);
+}
+
+// Take ownership without allocating. Native deleters are non-throwing.
+template <typename Handle, void (*Destroy)(Handle)>
+auto whisper_own_handle(Handle handle) {
+    return std::unique_ptr<typename std::remove_pointer<Handle>::type, decltype(Destroy)>(handle, Destroy);
+}
+
+// The acquired handle stays owned if a container insertion allocates or throws.
+template <typename Handle, void (*Destroy)(Handle), typename Container>
+void whisper_adopt_handle(Container & destination, Handle handle) {
+    auto owner = whisper_own_handle<Handle, Destroy>(handle);
+    destination.emplace_back(handle);
+    owner.release();
+}
+
+// Stack-owned C-style aggregates, such as batch allocation tables, must be safe
+// for partial cleanup and transfer their pointer fields only after full success.
+template <typename T, void (*Destroy)(T)>
+class whisper_init_value_owner {
+    static_assert(std::is_trivially_copyable<T>::value, "resource aggregate must copy without throwing");
+    T value{};
+    bool owned = true;
+public:
+    whisper_init_value_owner() = default;
+    whisper_init_value_owner(const whisper_init_value_owner &) = delete;
+    whisper_init_value_owner & operator=(const whisper_init_value_owner &) = delete;
+    ~whisper_init_value_owner() { if (owned) Destroy(value); }
+    T & get() noexcept { return value; }
+    T release() noexcept { owned = false; return value; }
+};
+
+inline size_t whisper_checked_allocation_size(size_t count, size_t element_size) {
+    if (element_size && count > std::numeric_limits<size_t>::max() / element_size) {
+        throw std::bad_alloc();
+    }
+    return count * element_size;
+}
+
+// Allocator argument supports isolated fault injection of this production check.
+// The shipped path always uses the standard C allocator.
+inline void * whisper_checked_malloc(size_t bytes, void * (*allocate)(size_t) = std::malloc) {
+    if (void * result = allocate(bytes)) return result;
+    throw std::bad_alloc();
+}
+
+// Own native handles immediately, including while push_back can allocate/throw.
+// A successful release transfers the same ordered vector to its final owner.
+template <typename Handle, void (*Destroy)(Handle)>
+class whisper_owned_handles {
+    std::vector<Handle> handles;
+public:
+    whisper_owned_handles() = default;
+    whisper_owned_handles(const whisper_owned_handles &) = delete;
+    whisper_owned_handles & operator=(const whisper_owned_handles &) = delete;
+    ~whisper_owned_handles() {
+        for (auto handle : handles) {
+            Destroy(handle);
+        }
+    }
+    void push_back(Handle handle) {
+        whisper_adopt_handle<Handle, Destroy>(handles, handle);
+    }
+    std::vector<Handle> release() noexcept {
+        std::vector<Handle> result;
+        result.swap(handles);
+        return result;
+    }
+};
+
+#endif
